diff --git a/components/microlink/src/microlink.c b/components/microlink/src/microlink.c
index 237f039..f063a8a 100644
--- a/components/microlink/src/microlink.c
+++ b/components/microlink/src/microlink.c
@@ -514,7 +514,11 @@ esp_err_t microlink_stop(microlink_t *ml) {
-    /* Wait for tasks to exit (they check ML_EVT_SHUTDOWN_REQUEST).
-     * Tasks call vTaskDelete(NULL) to self-delete, so we must NOT call
-     * vTaskDelete() on them again — that causes a crash in uxListRemove
-     * because the task's list node is already invalid. Just wait and
-     * NULL the handles. */
-    vTaskDelay(pdMS_TO_TICKS(3000));
-
+    /* Wake a blocked coord recv; the coord task retains ownership of close(). */
+    if (ml->coord_sock >= 0) shutdown(ml->coord_sock, SHUT_RDWR);
+
+    TaskHandle_t tasks[] = { ml->net_io_task, ml->derp_tx_task, ml->coord_task, ml->wg_mgr_task };
+    EventBits_t bits[] = { ML_EVT_NET_EXIT, ML_EVT_DERP_EXIT, ML_EVT_COORD_EXIT, ML_EVT_WG_EXIT };
+    for (size_t i = 0; i < sizeof(tasks) / sizeof(tasks[0]); ++i) {
+        if (!tasks[i]) continue;
+        xEventGroupWaitBits(ml->events, bits[i], pdFALSE, pdTRUE, portMAX_DELAY);
+        while (eTaskGetState(tasks[i]) != eSuspended) vTaskDelay(1);
+        vTaskDelete(tasks[i]);
+    }
